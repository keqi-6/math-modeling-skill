{
  "schema_version": "15.0",
  "owner": "references/capability-packet-registry.json",
  "status": "candidate",
  "purpose": "Keep normative atomic rules small while preserving complete task procedures through selectively loaded capability packets.",
  "normative_boundary": {
    "rules": "rules/*.json own what is required, when it applies, and what counts as acceptance.",
    "controller": "SKILL.md and machine contracts own authorization, routing, state, evidence persistence, and execution boundaries.",
    "packets": "Capability packets are non-normative implementations of how to perform an already-selected capability; they cannot add permission, strengthen an atom, or broaden scope.",
    "archive": "Preservation and migration records support audit and recovery of meaning but are not runtime instructions."
  },
  "loading_policy": {
    "selection_unit": "route_step",
    "router_first": true,
    "read_selected_packet_completely": true,
    "never_execute_from_atom_gloss_alone": true,
    "default_packet_limit_per_step": 3,
    "overflow_policy": "Split only at a real task phase boundary, retain a short continuation capsule, and read the next required packet completely before that phase starts.",
    "no_global_preload": true
  },
  "routers": [
    "references/project-method-notes.md",
    "references/data-method-notes.md",
    "references/modeling-method-notes.md",
    "references/verification-method-notes.md",
    "references/manuscript-method-notes.md",
    "references/visual-method-notes.md",
    "references/evidence-method-notes.md",
    "references/maintenance-method-notes.md"
  ],
