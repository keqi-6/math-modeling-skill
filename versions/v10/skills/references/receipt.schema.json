{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/modeling-controller-v10/receipt.schema.json",
  "title": "V10 execution receipt",
  "oneOf": [
    {"$ref": "#/$defs/start"},
    {"$ref": "#/$defs/end"}
  ],
  "$defs": {
    "base_properties": {
      "schema_version": {"const": "10.0"},
      "request": {"type": "string", "minLength": 1},
      "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "project_root": {"type": ["string", "null"]},
      "execution_id": {"type": ["string", "null"]},
      "component_id": {"type": ["string", "null"]},
      "component_map": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}},
      "mode": {"enum": ["advisory_readonly", "project_readonly", "mutate", "promote", "skill_maintenance"]},
      "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type", "schema_version", "request", "request_hash", "project_root", "execution_id", "component_id", "component_map", "mode",
        "route_ids", "rule_ids", "component_ids", "state_revision", "recovery", "planned_artifacts", "blocked"
      ],
      "properties": {
        "receipt_type": {"const": "start"},
        "schema_version": {"const": "10.0"},
        "request": {"type": "string", "minLength": 1},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_root": {"type": ["string", "null"]},
        "execution_id": {"type": ["string", "null"]},
        "component_id": {"type": ["string", "null"]},
        "component_map": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}},
        "mode": {"enum": ["advisory_readonly", "project_readonly", "mutate", "promote", "skill_maintenance"]},
        "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "state_revision": {"type": ["integer", "null"], "minimum": 0},
        "recovery": {"enum": ["R0_CONTINUE", "R1_TARGETED", "R2_FULL", "not_applicable"]},
        "planned_artifacts": {"type": "array", "items": {"$ref": "artifact-contract.json"}},
        "blocked": {"type": "boolean"}
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type", "schema_version", "request", "request_hash", "project_root", "execution_id", "component_id", "component_map", "mode",
        "route_ids", "rule_ids", "component_ids", "before_revision", "after_revision",
        "changed_artifacts", "validations", "state_transitions", "open_issues", "next_actions"
      ],
      "properties": {
        "receipt_type": {"const": "end"},
        "schema_version": {"const": "10.0"},
        "request": {"type": "string", "minLength": 1},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_root": {"type": ["string", "null"]},
        "execution_id": {"type": ["string", "null"]},
        "component_id": {"type": ["string", "null"]},
        "component_map": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}},
        "mode": {"enum": ["advisory_readonly", "project_readonly", "mutate", "promote", "skill_maintenance"]},
        "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "before_revision": {"type": ["integer", "null"], "minimum": 0},
        "after_revision": {"type": ["integer", "null"], "minimum": 0},
        "changed_artifacts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "status"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "status": {"enum": ["created", "modified", "deleted", "unchanged"]}
            }
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "status", "kind", "evidence_ref"],
            "properties": {
              "id": {"type": "string"},
              "status": {"enum": ["pass", "fail", "not_applicable"]},
              "kind": {"enum": ["file", "command", "citation", "observation", "decision"]},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "state_transitions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "from", "to"],
            "properties": {"component_id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}}
          }
        },
        "open_issues": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
