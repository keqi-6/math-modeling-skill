{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/modeling-controller-v10/release-manifest.schema.json",
  "title": "V10 frozen release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "status",
    "generated_at",
    "source_status",
    "manifest_policy",
    "release_tree",
    "validator_hashes",
    "pre_freeze_gate",
    "unverified_boundaries",
    "attestation",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "10.0"},
    "release_id": {"const": "V10.0.0"},
    "status": {"const": "stable"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_status": {"const": "candidate"},
    "manifest_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "excluded_paths"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-file-list-v1"},
        "excluded_paths": {
          "const": ["evals/release/frozen-manifest.json"]
        }
      }
    },
    "release_tree": {"$ref": "#/$defs/tree"},
    "validator_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(scripts|references)/.+"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "pre_freeze_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "tree_sha256", "validator_hashes_sha256", "drivers"],
      "properties": {
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validator_hashes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "drivers": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command_sha256", "exit_code", "executed_count", "auxiliary_executed_count", "stdout_sha256"],
            "properties": {
              "id": {"type": "string"},
              "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "exit_code": {"type": "integer"},
              "executed_count": {"type": "integer", "minimum": 1},
              "auxiliary_executed_count": {"type": "integer", "minimum": 0},
              "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "unverified_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest_algorithm", "external_signature"],
      "properties": {
        "kind": {"const": "self_hash_plus_fresh_independent_regate"},
        "digest_algorithm": {"const": "sha256"},
        "external_signature": {"const": null}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "file_count", "files"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
