{
  "schema_version": "11.0",
  "semantic_plan_schema": "references/semantic-plan.schema.json",
  "selection_policy": {
    "input": "agent_semantic_plan",
    "raw_request_classification": false,
    "single_global_mode": false,
    "dependency_policy": "block_descendants_only",
    "rule_delivery": "deduplicated_runtime_semantic_projections_once",
    "dangerous_action_execution": "optional_step_runtime_actions_with_same_process_revalidation",
    "unresolved_agent_obligation": {
      "G0_ADVISORY": "defer",
      "G1_WORKING": "defer",
      "G2_CHECKPOINT": "block_step",
      "G3_RELEASE": "block_step"
    },
    "unresolved_runtime_safety_guard": "block_step"
  },
  "action_contracts": {
    "RT.PROJECT.ADVISE": {
      "advise": {"required_all_events": []},
      "explain": {"required_all_events": []}
    },
    "RT.PROJECT.AUDIT": {
      "audit": {"required_any_events": ["scope_definition", "project_planning", "project_resume", "project_initialization"]},
      "inspect": {"required_any_events": ["scope_definition", "project_planning", "project_resume", "project_initialization"]}
    },
    "RT.PROJECT.INIT": {
      "initialize": {"required_all_events": ["project_initialization"]}
    },
    "RT.PROJECT.PLAN": {
      "scope": {"required_all_events": ["scope_definition"]},
      "plan": {"required_all_events": ["project_planning"]},
      "replan": {"required_all_events": ["project_planning"]}
    },
    "RT.PROJECT.RECOVER.MISSING": {
      "resume": {"required_all_events": ["recovery_assessment"], "maximum_tier": "G1_WORKING"},
      "recover": {"required_all_events": ["recovery_assessment"], "maximum_tier": "G1_WORKING"},
      "handoff": {"required_all_events": ["recovery_assessment"], "maximum_tier": "G1_WORKING"}
    },
    "RT.PROJECT.RESUME": {
      "resume": {"required_all_events": ["project_resume"]},
      "recover": {"required_all_events": ["recovery_assessment"]},
      "handoff": {"required_all_events": ["handoff"], "maximum_tier": "G1_WORKING"},
      "pause": {
        "required_all_events": ["handoff"],
        "minimum_tier": "G1_WORKING", "maximum_tier": "G1_WORKING",
        "required_mode": "mutate", "component_id_must_be_null": true,
        "allowed_change_path_prefixes": [".modeling/"]
      }
    },
    "RT.PROBLEM.DEFINE": {
      "restate": {"required_all_events": ["problem_definition"]},
      "define": {"required_all_events": ["problem_definition"]}
    },
    "RT.LITERATURE.SEARCH": {
      "search": {"required_all_events": ["literature_search"]},
      "review": {"required_any_events": ["literature_search", "source_selection", "source_claim"]},
      "cite": {"required_all_events": ["source_claim"]},
      "verify_policy": {"required_all_events": ["time_sensitive_policy_use"]}
    },
    "RT.DATA.AUDIT": {
      "audit": {"required_all_events": ["data_audit"]},
      "inspect": {"required_all_events": ["data_audit"]},
      "profile": {"required_all_events": ["data_audit"]}
    },
    "RT.DATA.TREAT": {
      "clean": {"required_all_events": ["data_treatment"]},
      "preprocess": {"required_all_events": ["data_treatment"]},
      "treat": {"required_all_events": ["data_treatment"]}
    },
    "RT.DATA.FREEZE": {
      "freeze": {"required_all_events": ["dataset_freeze", "artifact_promotion"], "minimum_tier": "G2_CHECKPOINT", "required_mode": "promote"},
      "promote": {"required_all_events": ["dataset_freeze", "artifact_promotion"], "minimum_tier": "G2_CHECKPOINT", "required_mode": "promote"}
    },
    "RT.DATA.REAUDIT": {
      "reaudit": {"required_all_events": ["data_audit"]},
      "reopen": {"required_all_events": ["data_audit"]}
    },
    "RT.MODEL.COMPARE": {
      "compare": {"required_all_events": ["model_comparison"]},
      "design": {"required_all_events": ["problem_definition"]},
      "select": {"required_all_events": ["model_selection"]}
    },
    "RT.MODEL.SPEC": {
      "specify": {"required_all_events": ["model_specification"]},
      "freeze_spec": {"required_all_events": ["model_specification"], "minimum_tier": "G2_CHECKPOINT", "required_mode": "promote", "requires_state_effect": true}
    },
    "RT.MODEL.IMPLEMENT": {
      "implement": {"required_all_events": ["model_implementation"]},
      "solve": {"required_all_events": ["model_execution"]},
      "compute": {"required_all_events": ["model_execution"]}
    },
    "RT.MODEL.RESULTS": {
      "analyze_results": {"required_all_events": ["result_interpretation"]},
      "interpret": {"required_all_events": ["result_interpretation"]}
    },
    "RT.VERIFY.IMPLEMENTATION": {
      "verify_implementation": {"required_all_events": ["implementation_verification"]},
      "verify_solution": {"required_all_events": ["numerical_verification"]}
    },
    "RT.VERIFY.MODEL": {
      "validate_model": {"required_all_events": ["structural_verification", "reality_verification"]},
      "robustness": {"required_all_events": ["robustness_analysis"]},
      "uncertainty": {"required_all_events": ["uncertainty_analysis"]}
    },
    "RT.VERIFY.S6.READINESS": {
      "audit_s6": {"required_all_events": ["s6_readiness"]},
      "assess_s6_readiness": {"required_all_events": ["s6_readiness"]}
    },
    "RT.VERIFY.S6.CLOSE": {
      "close_s6": {"required_all_events": ["s6_close"], "minimum_tier": "G2_CHECKPOINT", "required_mode": "promote", "requires_state_effect": true}
    },
    "RT.MANUSCRIPT.DRAFT": {
      "draft": {"required_all_events": ["manuscript_write"]},
      "rewrite": {"required_all_events": ["manuscript_write"]},
      "structure": {"required_all_events": ["manuscript_structure"]}
    },
    "RT.MANUSCRIPT.RENDER": {
      "render": {"required_all_events": ["visual_render"]},
      "typeset": {"required_all_events": ["visual_render"]},
      "layout_check": {"required_all_events": ["visual_audit"]}
    },
    "RT.MANUSCRIPT.LOCAL": {
      "local_edit": {"required_all_events": ["local_manuscript_edit"]},
      "fix_typo": {"required_all_events": ["local_manuscript_edit"]},
      "polish_paragraph": {"required_all_events": ["local_manuscript_edit"]}
    },
    "RT.MANUSCRIPT.REOPEN": {
      "reopen_published": {"required_all_events": ["published_manuscript_change"]}
    },
    "RT.MANUSCRIPT.AUDIT": {
      "audit": {"required_all_events": ["manuscript_audit"]},
      "final_audit": {"required_all_events": ["full_manuscript_audit", "manuscript_audit"]}
    },
    "RT.VISUAL.CREATE": {
      "create": {"required_any_events": ["visual_generate", "visual_render"]},
      "revise": {"required_any_events": ["visual_design", "visual_generate", "visual_render"]},
      "layout": {"required_any_events": ["visual_design", "visual_render"]}
    },
    "RT.VISUAL.AUDIT": {
      "audit": {"required_all_events": ["visual_audit"]},
      "verify": {"required_all_events": ["visual_audit"]}
    },
    "RT.DELIVERY.FINAL": {
      "finalize": {"required_all_events": ["final_delivery"], "minimum_tier": "G3_RELEASE", "required_mode": "promote"},
      "package": {"required_all_events": ["delivery_package_build"], "minimum_tier": "G3_RELEASE", "required_mode": "promote"},
      "deliver": {"required_all_events": ["final_delivery"], "minimum_tier": "G3_RELEASE", "required_mode": "promote"}
    },
    "RT.SKILL.AUDIT": {
      "audit": {"required_all_events": ["rule_load"]},
      "review": {"required_all_events": ["rule_load"]}
    },
    "RT.SKILL.CHANGE": {
      "add_rule": {"required_all_events": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_add", "rule_change", "normative_behavior_change"]},
      "modify_rule": {"required_all_events": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_modify", "rule_change", "normative_behavior_change"]},
      "retire_rule": {"required_all_events": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_change", "normative_behavior_change"]},
      "change_route": {"required_all_events": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_change", "normative_behavior_change"]},
      "change_state": {"required_all_events": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_change", "normative_behavior_change"]},
      "release": {"required_all_events": ["release_candidate_validation", "release_report"], "minimum_tier": "G3_RELEASE"}
    }
  },
  "event_prerequisites": {
    "controller_only_events": ["request_received", "route_resolution", "route_execution", "before_write", "before_file_creation"],
    "events": {
      "artifact_promotion": {"minimum_tier": "G2_CHECKPOINT", "required_mode": "promote"},
      "manuscript_promotion": {"minimum_tier": "G2_CHECKPOINT", "required_mode": "promote"},
      "state_transition": {"minimum_tier": "G2_CHECKPOINT", "required_mode": "promote", "requires_state_effect": true},
      "final_delivery": {"minimum_tier": "G3_RELEASE", "required_mode": "promote"},
      "start_receipt_validation": {"minimum_tier": "G2_CHECKPOINT"},
      "end_receipt_validation": {"minimum_tier": "G2_CHECKPOINT"},
      "recovery_assessment": {"minimum_tier": "G1_WORKING"},
      "writing_profile_apply": {"requires_profile_selection": true},
      "before_frozen_change": {"minimum_tier": "G2_CHECKPOINT"}
    }
  },
  "legacy_scope_adapters": {
    "skill_state": {
      "actual_state": "V11",
      "frozen_scope_token": "V10",
      "domain": "maintenance",
      "provenance": "inherited_v10_maintenance_scope_compatibility"
    }
  },
  "legacy_trigger_adapters": {
    "DATA.IDENTITY.BEFORE_USE": {
      "coarse_controller_event": "route_execution",
      "when_fact_true": "consumes_data",
      "when_any_actual_event": [
        "data_treatment",
        "dataset_freeze",
        "frozen_dataset_change",
        "model_execution",
        "result_interpretation",
        "numerical_comparison",
        "numerical_verification",
        "uncertain_result_visualization"
      ],
      "provenance": "frozen instruction_gloss narrows the coarse V10 route_execution token to actual data consumption"
    }
  },
  "tier_policy": {
    "G0_ADVISORY": ["advisory_readonly", "project_readonly"],
    "G1_WORKING": ["advisory_readonly", "project_readonly", "mutate", "skill_maintenance"],
    "G2_CHECKPOINT": ["advisory_readonly", "project_readonly", "mutate", "promote", "skill_maintenance"],
    "G3_RELEASE": ["project_readonly", "mutate", "promote", "skill_maintenance"]
  },
  "event_policy": {
    "source": "semantic_plan.steps[].events",
    "broadcast": false,
    "controller_events": {
      "per_step": ["request_received", "route_resolution", "route_execution"],
      "before_writable_step": ["before_write"],
      "scope": "one_semantic_step",
      "rule_domain": "all_domains_by_declared_trigger",
      "purpose": "preserve governance applicability without creating a request-wide mode or broadcasting the V10 event bundle"
    },
    "known_events": [
      "artifact_promotion", "artifact_refresh", "artifact_register", "authorized_stateful_execution",
      "before_claim", "before_file_creation", "before_frozen_change", "before_write",
      "conclusion_write", "data_audit", "data_treatment", "dataset_freeze", "dataset_register",
      "delivery_package_build", "design_decision", "end_receipt_validation", "evidence_record",
      "external_claim_record", "final_delivery", "frozen_dataset_change", "full_manuscript_audit",
      "handoff", "high_impact_claim_review", "high_risk_change", "high_risk_release_validation",
      "implementation_verification", "literature_search", "local_manuscript_edit", "major_release",
      "manuscript_audit", "manuscript_promotion", "manuscript_structure", "manuscript_write",
      "method_section_write", "model_comparison", "model_execution", "model_implementation",
      "model_selection", "model_specification", "normative_behavior_change", "numerical_comparison",
      "numerical_verification", "package_external_material", "planning_complete", "problem_definition",
      "project_initialization", "project_planning", "project_resume", "provenance_record",
      "published_manuscript_change", "reality_verification", "recovery_assessment",
      "release_candidate_validation", "release_report", "request_received", "result_interpretation",
      "result_record", "result_section_write", "result_summary", "robustness_analysis",
      "route_execution", "route_resolution", "rule_add", "rule_change", "rule_change_analysis",
      "rule_change_request", "rule_load", "rule_modify", "s6_close", "s6_readiness",
      "scope_definition", "source_claim", "source_register", "source_selection",
      "start_receipt_validation", "state_read", "state_transition", "state_write",
      "structural_verification", "structure_design", "time_sensitive_policy_use",
      "uncertain_result_visualization", "uncertainty_analysis", "visual_audit", "visual_design",
      "visual_embed", "visual_generate", "visual_render", "visual_source_change",
      "writing_profile_apply"
    ],
    "control_events": [
      "artifact_promotion", "artifact_refresh", "artifact_register", "authorized_stateful_execution",
      "before_claim", "before_file_creation", "before_frozen_change", "before_write",
      "design_decision", "end_receipt_validation", "evidence_record", "recovery_assessment",
      "start_receipt_validation",
      "state_read", "state_transition", "state_write"
    ],
    "route_allowed_events": {
      "RT.PROJECT.ADVISE": [],
      "RT.PROJECT.AUDIT": ["project_initialization", "project_planning", "project_resume", "scope_definition"],
      "RT.PROJECT.INIT": ["project_initialization", "scope_definition", "project_planning", "structure_design"],
      "RT.PROJECT.PLAN": ["scope_definition", "project_planning", "structure_design", "planning_complete", "problem_definition", "handoff"],
      "RT.PROJECT.RECOVER.MISSING": ["project_initialization", "project_resume", "handoff"],
      "RT.PROJECT.RESUME": ["project_initialization", "project_resume", "project_planning", "planning_complete", "handoff"],
      "RT.PROBLEM.DEFINE": ["scope_definition", "problem_definition"],
      "RT.LITERATURE.SEARCH": ["literature_search", "source_selection", "source_claim", "high_impact_claim_review", "time_sensitive_policy_use", "external_claim_record", "source_register", "provenance_record"],
      "RT.DATA.AUDIT": ["data_audit", "dataset_register", "source_register", "external_claim_record", "provenance_record"],
      "RT.DATA.TREAT": ["data_treatment", "dataset_register"],
      "RT.DATA.FREEZE": ["data_treatment", "dataset_freeze", "dataset_register", "frozen_dataset_change"],
      "RT.DATA.REAUDIT": ["data_audit", "frozen_dataset_change"],
      "RT.MODEL.COMPARE": ["problem_definition", "model_comparison", "model_selection", "high_impact_claim_review"],
      "RT.MODEL.SPEC": ["model_specification"],
      "RT.MODEL.IMPLEMENT": ["model_implementation", "model_execution", "result_record"],
      "RT.MODEL.RESULTS": ["result_record", "result_interpretation", "result_summary"],
      "RT.VERIFY.IMPLEMENTATION": ["implementation_verification", "numerical_verification", "numerical_comparison", "result_summary"],
      "RT.VERIFY.MODEL": ["structural_verification", "reality_verification", "uncertainty_analysis", "robustness_analysis"],
      "RT.VERIFY.S6.READINESS": ["s6_readiness", "implementation_verification", "numerical_verification", "numerical_comparison", "structural_verification", "reality_verification", "uncertainty_analysis", "robustness_analysis"],
      "RT.VERIFY.S6.CLOSE": ["s6_readiness", "s6_close", "implementation_verification", "numerical_verification", "numerical_comparison", "structural_verification", "reality_verification"],
      "RT.MANUSCRIPT.DRAFT": ["manuscript_structure", "manuscript_write", "manuscript_audit", "method_section_write", "result_section_write", "conclusion_write", "writing_profile_apply", "result_interpretation", "external_claim_record"],
      "RT.MANUSCRIPT.RENDER": ["visual_render", "visual_audit", "visual_embed"],
      "RT.MANUSCRIPT.LOCAL": ["local_manuscript_edit", "manuscript_write", "manuscript_audit", "writing_profile_apply"],
      "RT.MANUSCRIPT.REOPEN": ["published_manuscript_change"],
      "RT.MANUSCRIPT.AUDIT": ["full_manuscript_audit", "manuscript_audit", "manuscript_structure", "manuscript_write", "manuscript_promotion", "method_section_write", "result_section_write", "conclusion_write", "source_claim", "time_sensitive_policy_use", "external_claim_record", "result_interpretation", "visual_audit", "visual_design", "visual_render", "visual_embed"],
      "RT.VISUAL.CREATE": ["visual_design", "visual_render", "visual_generate", "visual_embed", "visual_audit", "uncertain_result_visualization"],
      "RT.VISUAL.AUDIT": ["visual_design", "visual_render", "visual_generate", "visual_embed", "visual_audit", "visual_source_change", "uncertain_result_visualization"],
      "RT.DELIVERY.FINAL": ["final_delivery", "delivery_package_build", "handoff", "planning_complete", "package_external_material", "source_register", "external_claim_record", "time_sensitive_policy_use", "manuscript_promotion", "visual_audit", "visual_source_change"],
      "RT.SKILL.AUDIT": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_change"],
      "RT.SKILL.CHANGE": ["rule_load", "rule_change_request", "rule_change_analysis", "rule_change", "rule_add", "rule_modify", "normative_behavior_change", "release_candidate_validation", "high_risk_release_validation", "high_risk_change", "major_release", "release_report"]
    }
  },
  "semantic_plan_policy": {
    "required_step_fields": [
      "id", "tier", "mode", "object", "action", "component_id",
      "events", "facts", "depends_on"
    ],
    "action_field": "routes[].intents",
    "legacy_route_fields_ignored": [
      "patterns", "exclude_patterns", "priority", "phase", "after_objects", "recovery"
    ],
    "change_set_fields": ["paths", "facets", "claim_refs"],
    "working_context": {
      "tiers": ["G0_ADVISORY", "G1_WORKING"],
      "fields": ["component_type", "state"],
      "checkpoint_disposition": "authoritative_state_required",
      "missing_ambiguous_context": "block_step"
    },
    "event_validation": "known_and_route_or_control",
    "recovery_activation": "explicit_recovery_assessment_event_only",
    "invalid_state_recovery_binding": "recovery_actions_bind_only_to_RT.PROJECT.RECOVER.MISSING_and_ignore_working_context",
    "window_context": {
      "enum": ["same_window", "new_window", "unknown"],
      "required_for_recovery_assessment": true,
      "missing_or_unknown_default": "new_window",
      "r0_allowed_only_for": "same_window"
    }
  },
  "runtime_action_policy": {
    "ordinary_work_requires_runtime_action": false,
    "ordinary_work_examples": ["read", "edit", "multi_file_change", "compile", "render", "scoped_nonexecuting_audit"],
    "guarded_kinds": [
      "project_model_execution", "project_verification_execution",
      "recompute_existing_result", "skill_targeted_validation",
      "skill_package_validation", "full_project_audit"
    ],
    "kind_events": {
      "project_model_execution": ["model_execution"],
      "project_verification_execution": ["implementation_verification", "numerical_verification", "structural_verification", "reality_verification", "robustness_analysis", "uncertainty_analysis"],
      "recompute_existing_result": ["model_execution", "implementation_verification", "numerical_verification", "structural_verification", "reality_verification", "robustness_analysis", "uncertainty_analysis"],
      "skill_targeted_validation": ["rule_change_analysis", "normative_behavior_change"],
      "skill_package_validation": ["release_candidate_validation"],
      "full_project_audit": ["scope_definition", "project_planning", "project_resume"]
    },
    "direct_authorization_only_kinds": ["recompute_existing_result", "skill_package_validation", "full_project_audit"],
    "non_derivation_actions": ["resume", "recover", "handoff", "pause", "audit_s6", "assess_s6_readiness", "close_s6", "finalize", "package", "deliver"],
    "skill_package_boundary": {
      "object": "skill", "tier": "G3_RELEASE", "mode": "skill_maintenance",
      "scope_kind": "skill_candidate"
    },
    "grant_binding": [
      "request_hash", "plan_hash", "step_id", "runtime_action_id", "event",
      "scope", "command_hash", "project_root", "state_revision", "recovery_posture"
    ],
    "execution_entry": "scripts/run_authorized_action.py",
    "g1_persistence": "none"
  },
  "routes": [
    {
      "id": "RT.PROJECT.ADVISE", "object": "project", "intents": ["advise", "explain"],
      "patterns": ["项目.*(?:建议|解释|方案|怎么|如何)", "(?:建议|解释|方案).*(?:项目|建模)", "(?:工作|项目).*(?:是否.*完成|完成.*(?:了吗|么))", "project.*(?:advise|explain|how)"],
      "exclude_patterns": ["skill|技能"], "modes": ["advisory_readonly"], "component_types": ["project", "none"],
      "states": ["UNINITIALIZED", "P0", "P1", "P2"], "priority": 20, "write_policy": "never", "recovery": false,
      "phase": 0, "after_objects": [], "expected_outputs": ["advisory_response"], "exclusions": ["project_file_creation"],
      "context_refs": []
    },
    {
      "id": "RT.PROJECT.AUDIT", "object": "project", "intents": ["audit", "inspect"],
      "patterns": ["(?:项目|工程).*(?:审计|检查|核对|复核|评估)", "(?:审计|检查|核对|复核|评估).*(?:项目|工程)", "(?:audit|inspect|review).*project"],
      "exclude_patterns": ["skill|技能"], "modes": ["project_readonly"], "component_types": ["project"],
      "states": ["UNINITIALIZED", "P0", "P1", "P2"], "priority": 80, "write_policy": "never", "recovery": true,
      "phase": 0, "after_objects": [], "expected_outputs": ["scoped_project_audit"], "exclusions": ["project_mutation", "claim_beyond_read_scope"],
      "context_refs": [{"ref": "references/project-method-notes.md#recovery", "when_any": ["接手", "恢复", "resume", "recover"]}]
    },
    {
      "id": "RT.PROJECT.INIT", "object": "project", "intents": ["initialize"],
      "patterns": ["(?:创建|新建|初始化).*(?:项目|平台|工程)", "(?:项目|平台|工程).*(?:创建|新建|初始化)", "init(?:ialize)?.*project"],
      "exclude_patterns": ["skill|技能|v10"], "modes": ["mutate"], "component_types": ["project"], "states": ["UNINITIALIZED"],
      "priority": 100, "write_policy": "authorized", "recovery": false, "phase": 0, "after_objects": [],
      "expected_outputs": ["minimal_project_state"], "exclusions": ["full_scaffold", "placeholder_files", "default_readme"],
      "context_refs": [{"ref": "references/project-method-notes.md#minimal-platform", "when_any": []}]
    },
    {
      "id": "RT.PROJECT.PLAN", "object": "project", "intents": ["scope", "plan", "replan"],
      "patterns": ["(?:项目|题目).*(?:范围|计划|规划|拆解|方案)", "(?:范围|计划|规划|拆解).*(?:项目|题目)", "(?:scope|plan|replan).*project"],
      "exclude_patterns": ["skill|技能"], "modes": ["advisory_readonly", "project_readonly", "mutate"],
      "component_types": ["project", "question", "none"], "states": ["UNINITIALIZED", "P0", "P1", "S0", "S1", "S2", "S3"],
      "priority": 40, "write_policy": "mode_dependent", "recovery": false, "phase": 0, "after_objects": [],
      "expected_outputs": ["scope_or_plan"], "exclusions": ["unrequested_scaffold"],
      "context_refs": [{"ref": "references/project-method-notes.md#scope-and-decomposition", "when_any": []}]
    },
    {
