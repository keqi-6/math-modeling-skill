  "retired_legacy_boundary": {
    "decision": "references/preservation/legacy-executable-retirement.json",
    "status": "retired_after_useful_behavior_migration",
    "callable_compatibility_promised": false,
    "historical_lineage_remains_audit_evidence": true,
    "maintenance_audits_integrated_by_contracts": [
      "scripts/validate_capability_packets.py",
      "scripts/validate_migration.py"
    ],
    "not_release_evidence": [
      "keyword_presence",
      "heading_presence",
      "raw_assertion_count",
      "mutation_count",
      "a_validator_accepting_an_artifact_written_only_for_that_validator"
    ]
  },
  "budget": {
    "active_driver_count": 3,
    "default_timeout_seconds_per_driver": 60,
    "full_legacy_suite_on_every_release": false,
    "ordinary_project_steps_invoke_release_gate": false
  }
}
