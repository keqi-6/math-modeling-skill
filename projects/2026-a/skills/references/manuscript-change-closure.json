{
  "schema_version": "11.0",
  "contract_kind": "manuscript_minimum_consistency_closure",
  "purpose": "Preserve every V10 manuscript rule while declaring only the minimum actual event and evaluation surface justified by a V11 plan step; frozen atoms remain the sole rule selector.",
  "authority_boundary": {
    "owns": [
      "manuscript_change_class_vocabulary",
      "manuscript_facet_event_normalization",
      "manuscript_evaluation_closure",
      "manuscript_change_set_scope",
      "manuscript_dependency_propagation_boundary"
    ],
    "does_not_own": [
      "manuscript_rule_effects",
      "route_identity",
      "project_state_transitions",
      "recovery_classification"
    ]
  },
  "semantic_inventory": {
    "source": "rules/manuscript.json",
    "source_sha256": "211eaa9933c8e41e0723f9f865c58ad875f97602262efb2666e3123b9e2679fb",
    "active_rule_count": 29,
