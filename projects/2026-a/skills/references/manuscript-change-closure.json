        "MAN.PROFILE.FORMAT",
        "MAN.PROFILE.OPT_IN",
        "MAN.PROFILE.TRUTH"
      ]
    }
  },
  "plan_contract": {
    "selector": "step.facts.change_class",
    "required_fact_keys": [
      "change_class",
      "completion_scope",
      "profile_selected",
      "published_revision",
      "existing_paths_only"
    ],
    "unknown_change_class": "block_step:unknown_manuscript_change_class",
    "missing_contract": "block_step:manuscript_change_closure_contract_missing",
    "events_are_actual": true,
    "potential_events_must_not_be_emitted": true,
    "selection_algorithm": "Select the named change closure and validate its actual events and declared facets. A declared facet means the step actually writes or actually audits that semantic surface. Normalize only those facets through facet_to_legacy_event, then select manuscript atoms without filtering by their unchanged route, scope and trigger contracts. For a fixed closure, derived_expected_manuscript_rule_ids is a test oracle. For a compositional closure, derive the oracle from base_derived_expected_manuscript_rule_ids plus only overlays keyed by normalized legacy events. No derived field is a runtime allowlist. Never broadcast undeclared facets or infer an audit, recovery, artifact or upstream-model event from write mode alone."
  },
  "rule_count_telemetry_policy": {
    "field": "closures.*.rule_count_telemetry.expected_max_total_rule_count",
    "runtime_effect": "none",
    "purpose": "Detect accidental event or rule broadcast in evaluations without blocking a semantically valid step whose actual applicable rule set is larger."
  },
  "facet_to_legacy_event": {
    "method": "method_section_write",
    "result": "result_section_write",
    "conclusion": "conclusion_write",
    "structure": "manuscript_structure"
  },
  "global_invariants": {
    "all_29_rule_semantics_retained": true,
    "normative_strength_does_not_imply_per_turn_evidence": true,
    "change_set_is_the_write_unit": true,
    "one_file_at_a_time_forbidden": true,
    "existing_file_edits_do_not_trigger_artifact_admission": true,
    "recovery_requires_explicit_recovery_assessment_event": true,
    "explicit_window_recovery_is_orthogonal_to_manuscript_change_closure": true,
    "profile_requires_explicit_selection": true,
    "downstream_edits_never_rebind_or_mutate_upstream_sources": true,
    "whole_project_invalidation_for_local_manuscript_change_forbidden": true,
    "batch_change_set_impact_is_computed_once": true
  },
  "enforcement_by_tier": {
    "G1_WORKING": {
      "agent_obligation": "apply_to_changed_content_without_typed_evidence_or_state_gate",
      "failure_effect": "revise_or_report_changed_scope",
      "promotion_blocked": false
    },
    "G2_CHECKPOINT": {
      "agent_obligation": "evaluate_required_scope_as_pass_fail_or_not_applicable",
      "failure_effect": "block_only_the_checkpoint_step",
      "promotion_blocked": true
    },
    "G3_RELEASE": {
      "agent_obligation": "evaluate_release_scope_as_pass_fail_or_not_applicable",
      "failure_effect": "block_only_the_release_step",
      "promotion_blocked": true
    }
  },
  "profile_overlay": {
    "activation_any": [
      "step.facts.profile_selected == true",
      "writing_profile in step.change_set.facets"
    ],
    "required_event": "writing_profile_apply",
    "rule_ids": [
      "MAN.PROFILE.FORMAT",
      "MAN.PROFILE.OPT_IN",
      "MAN.PROFILE.TRUTH"
    ],
    "default_activation_forbidden": true
  },
